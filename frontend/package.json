    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "viem": "^2.57.13",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
