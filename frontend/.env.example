# Frontend environment variable NAMES. Copy to frontend/.env.local and fill in. Never commit .env.local.
# Public (browser-visible) values only go in NEXT_PUBLIC_* variables; nothing secret belongs here.

# --- API ---
# Same-origin setup: leave empty so the browser calls the frontend origin; Next.js rewrites /api/* to BACKEND_URL
NEXT_PUBLIC_API_BASE_URL=
# Server-side only: where the Next.js rewrite forwards /api/:path* (local backend shown)
BACKEND_URL=http://localhost:8000
# false = real backend; true = built-in mock backend (no network; for offline UI work and screenshots)
NEXT_PUBLIC_USE_MOCKS=false

# --- Voice ---
# auto = POST /api/transcribe (Wispr/Sarvam on the backend) with browser fallback; browser = Web Speech API only
NEXT_PUBLIC_VOICE_MODE=auto

# --- Wallet connection and attestations (Base Sepolia TESTNET only) ---
# Reown / WalletConnect project id (free). Without it only injected wallets (MetaMask, Coinbase) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# UID of the EAS schema registered once at https://base-sepolia.easscan.org/schema/create
# schema: string subjectAddress,string chain,uint8 riskScore,string verdict,bytes32 reportHash
NEXT_PUBLIC_EAS_SCHEMA_UID=
# EAS contract on Base Sepolia (OP-stack predeploy) and the chain id
NEXT_PUBLIC_EAS_CONTRACT=0x4200000000000000000000000000000000000021
NEXT_PUBLIC_CHAIN_ID=84532

# --- Payments ---
# Optional helper text shown next to the Dodo test checkout (e.g. test card details)
NEXT_PUBLIC_DODO_TEST_HINT=
